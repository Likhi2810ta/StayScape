<% layout("/layouts/boilerplate.ejs") -%>
<body>
    <div class="row mt-3" >
        <div class="col-8 offset-2">
            <h3>Edit the listing</h3>

    <form 
    method="post" 
    action="/listings/<%=listing._id%>?_method=put" 
    class="needs-validation"  
    enctype="multipart/form-data"
    novalidate>

        <div class="mb-3">
            <label for="title" class="form-label" >Title</label>
            <input name="listing[title]" class="form-control" value="<%=listing.title%>" type="text" required>
            <div class="invalid-feedback">
               Enter the title!
            </div>
        </div>
        
        
        <div class="mb-3">
            <label for="description" class="form-label" >Description</label>
            <textarea name="listing[description]" 
            class="form-control" 
            required><%=listing.description%></textarea>

            <div class="invalid-feedback">
               Please enter a short description
            </div>
        </div>

        <div class="mb-3">
    <label for="category" class="form-label">Category</label>
    <select
        class="form-select"
        id="category"
        name="listing[category]"
        required
    >
        <option value="" selected disabled>Select listing category</option>
        <option value="Trending">Trending</option>
        <option value="Iconic Cities">Iconic Cities</option>
        <option value="Rooms">Rooms</option>
        <option value="Mountains">Mountains</option>
        <option value="Farms">Farms</option>
        <option value="Camping">Camping</option>
        <option value="Beaches">Beaches</option>
        <option value="Amazing Pools">Amazing Pools</option>
        <option value="Arctic">Arctic</option>
        <option value="Boats">Boats</option>
        <option value="Castles">Castles</option>
    </select>

    <div class="invalid-feedback">
        Please select a category.
    </div>
</div>

        <div>
            <img src="<%=originalImageUrl%>"
        </div>
        
        <div class="mb-3">
             <label for="description" class="form-label" >Upload new image</label>
            <input 
            name="listing[image]" 
            class="form-control"
            type="file" >
        </div>

        <div class="row">
             <div class="mb-3 col-md-4">
             <label for="description" class="form-label" >Price</label>
             <input name="listing[price]" 
             class="form-control" 
             value="<%=listing.price%>" 
             type="number" 
             required>
             <div class="invalid-feedback">
               Enter a valid price!
            </div>
        </div>

        <div class="mb-3 col-md-8">
            <label for="description" class="form-label" >Country</label>
            <input name="listing[country]" 
            class="form-control" 
            value="<%=listing.country%>" 
            type="text" 
            required>

            <div class="invalid-feedback">
               Country in invalid!
            </div>
        </div>
        </div>

       

        <div class="mb-3">
             <label for="description" class="form-label" >Location</label>
            <input name="listing[location]" 
            class="form-control" 
            value="<%=listing.location%>" 
            type="text" 
            required>

            <div class="invalid-feedback">
               Please enter a valid location!
            </div>
        </div>
        
        
        
        <button class="btn btn-dark edit-btn mt-3">Edit</button>

    </form>
        </div>
        
    </div>
    
</body>
