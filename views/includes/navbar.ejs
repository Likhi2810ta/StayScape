<style>
  .navbar {
    background-color: white;
  }

  .navbar-brand {
    font-size: 1.5rem;
    font-weight: 700;
    color: #FF5A5F !important;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .navbar-brand i {
    font-size: 1.7rem;
  }

  .search-btn {
    background-color: #FF5A5F;
    color: white;
    border-radius: 25px;
    padding: 0 1rem;
    border: none;
  }

  .search-btn:hover {
    background-color: #e74c52;
    color: white;
  }

  .search-btn i {
    display: inline;
    margin-right: 0.5rem;
  }

  .search-inp {
    border-radius: 25px;
    padding: 0.55rem 2rem;
    font-size: 0.95rem;
    min-width: 260px;
  }

  .host-btn {
    background-color: #FF5A5F;
    color: white !important;
    border-radius: 25px;
    padding: 0.45rem 1rem !important;
    font-weight: 600;
    margin-right: 1rem;
    transition: 0.2s ease;
  }

  .host-btn:hover {
    background-color: #e74c52;
  }

  .nav-link {
    font-weight: 500;
  }

  .auth-link {
    font-weight: 600;
  }
</style>

<nav class="navbar navbar-expand-md border-bottom sticky-top">
  <div class="container-fluid">

    <!-- Brand -->
    <a class="navbar-brand" href="/listings">
      <i class="fa-solid fa-house-chimney"></i>
      StayScape
    </a>

    <button
      class="navbar-toggler"
      type="button"
      data-bs-toggle="collapse"
      data-bs-target="#navbarNavAltMarkup">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarNavAltMarkup">

      <!-- Left -->
      <div class="navbar-nav">
        <a class="nav-link" href="/listings">Explore</a>
      </div>

      <!-- Center Search -->
      <div class="navbar-nav mx-auto">
        <form class="d-flex" role="search" action="/listings/search">
          <input
            class="form-control me-2 search-inp"
            name="query"
            type="search"
            placeholder="Search destinations"
            aria-label="Search">

          <button class="btn search-btn" type="submit">
            <i class="fa-solid fa-magnifying-glass"></i>Search
          </button>
        </form>
      </div>

      <!-- Right -->
      <div class="navbar-nav align-items-center">

        <a class="nav-link host-btn" href="/listings/new">
          List Your Property
        </a>

        <% if(!currUser){ %>

          <a class="nav-link auth-link" href="/signup">Sign Up</a>

          <a class="nav-link auth-link" href="/login">Log In</a>

        <% } %>

        <% if(currUser){ %>

          <a class="nav-link auth-link" href="/logout">Log Out</a>

        <% } %>

      </div>

    </div>
  </div>
</nav>